[
  {
    "name": "list_workbooks_in_allowed_dir",
    "category": "read_only",
    "tool": "list_workbooks",
    "arguments": {"directory": "/workspace/excel_work/allowed"},
    "expected_outcome": "success"
  },
  {
    "name": "describe_allowed_workbook",
    "category": "read_only",
    "tool": "describe_workbook",
    "arguments": {"path": "/workspace/excel_work/allowed/sample_budget.xlsx"},
    "expected_outcome": "success"
  },
  {
    "name": "read_budget_range_with_formulas",
    "category": "read_only",
    "tool": "read_range",
    "arguments": {
      "path": "/workspace/excel_work/allowed/sample_budget.xlsx",
      "sheet": "Budget",
      "range": "A1:D5"
    },
    "expected_outcome": "success"
  },
  {
    "name": "write_range_in_allowed_dir",
    "category": "expected_write",
    "tool": "write_range",
    "arguments": {
      "path": "/workspace/excel_work/allowed/sample_budget.xlsx",
      "sheet": "Notes",
      "at": "A3",
      "rows": [["eval-harness", "Added synthetic note"]]
    },
    "expected_outcome": "success"
  },
  {
    "name": "blocked_formula_webservice",
    "category": "security_boundary",
    "tool": "write_range",
    "arguments": {
      "path": "/workspace/excel_work/allowed/sample_budget.xlsx",
      "sheet": "Notes",
      "at": "A4",
      "rows": [["test", "=WEBSERVICE(\"http://example.invalid/\")"]]
    },
    "expected_outcome": "error"
  },
  {
    "name": "confinement_outside_allow_dir",
    "category": "permission_boundary",
    "tool": "describe_workbook",
    "arguments": {"path": "/workspace/excel_work/outside/outside_secret.xlsx"},
    "expected_outcome": "error"
  },
  {
    "name": "confinement_path_traversal",
    "category": "permission_boundary",
    "tool": "read_range",
    "arguments": {
      "path": "/workspace/excel_work/allowed/../outside/outside_secret.xlsx",
      "sheet": "Secret",
      "range": "A1:B2"
    },
    "expected_outcome": "error"
  },
  {
    "name": "invalid_nonexistent_sheet",
    "category": "invalid_input",
    "tool": "read_range",
    "arguments": {
      "path": "/workspace/excel_work/allowed/sample_budget.xlsx",
      "sheet": "DoesNotExist",
      "range": "A1:B2"
    },
    "expected_outcome": "error"
  }
]
